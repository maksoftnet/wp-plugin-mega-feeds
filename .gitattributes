# Normalize line endings: LF in the repository, native in the working tree.
# Development is on Windows (Laragon), deployment target is Linux.
* text=auto eol=lf

# Explicit text types
*.php   text
*.js    text
*.css   text
*.json  text
*.md    text
*.yml   text
*.xml   text
*.sql   text

# Binary - never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
